# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
version: "0.1.1"
synopsis:
  "MCP server exposing the Abella proof assistant, including abella2tex rendering"
maintainer: ["nguermond@proton.me"]
authors: ["Nathan Guermond"]
license: "GPL-3.0-or-later"
homepage: "https://github.com/nguermond/abella-mcp"
bug-reports: "https://github.com/nguermond/abella-mcp/issues"
depends: [
  "dune" {>= "3.7"}
  "ocaml"
  "yojson"
  "jsonrpc"
  "odoc" {with-doc}
]
depopts: ["abella2tex"]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/nguermond/abella-mcp.git"
